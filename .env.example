# Copy to .env and fill in. .env is git-ignored; this file is committed.

# Postgres — the hosted Neon database (docs/00-global.md §0: never install
# Postgres locally). Copy the connection string from your Neon project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agriprice?sslmode=require"

# All dates and times are handled in this zone, never the server's clock zone.
APP_TZ="Africa/Lagos"

# Session encryption key (iron-session). At least 32 characters.
# Generate your own and never commit it: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32-or-more-random-characters"

# Shows the "Try demo account" button on the login page when true.
DEMO_MODE="true"

# Optional OpenWeatherMap key. Without it the app uses Open-Meteo (no key).
# OWM_API_KEY=""
# Optional real market API. Without it the simulated feed is used.
# MARKET_API_URL=""
